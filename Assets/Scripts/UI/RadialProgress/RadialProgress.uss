.radial-progress {
    min-width: 26px;
    min-height: 20px;
    --track-color: rgba(0, 0, 0, 0);
    --progress-color: rgba(255, 255, 255, 0.66);
    --percentage-color: white;
    --show-label: false;
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    flex-direction: row;
    justify-content: center;
    width: 100px; 
    height: 100px;
}

.radial-progress__label {
    -unity-text-align: middle-left;
    color: var(--percentage-color);
}
