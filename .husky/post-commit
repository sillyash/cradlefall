#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Determine Git context to decide whether to run versionize and with which args.
# Behavior requested by user:
# - If any branch (regular commit) -> don't versionize.
# - If we're in `beta` branch OR merging into `beta` -> run versionize with --pre-release.
# - If merging into `main` -> run versionize (no pre-release flag).

# Get current branch name (works in detached/merge states too)
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# Detect if this is a merge commit by checking for MERGE_HEAD
is_merge=false
merge_target=""
if [ -f "$(git rev-parse --git-dir 2>/dev/null)/MERGE_HEAD" ]; then
	is_merge=true
	# When merging, attempt to read the target branch from the MERGE_MSG or from refs
	# Try to parse 'Merge branch 'target' into' pattern from MERGE_MSG
	merge_msg_file="$(git rev-parse --git-dir)/MERGE_MSG"
	if [ -f "$merge_msg_file" ]; then
		merge_target=$(sed -n '1,3p' "$merge_msg_file" | sed -n "s/.*[Mm]erge branch '\?\([^' ]\+\)\?.*/\1/p" | head -n1)
	fi
	# Fallback: try to read the ref being merged (MERGE_HEAD points to a commit; map to refs in reflog)
	if [ -z "$merge_target" ]; then
		# Try to find refs that contain the MERGE_HEAD commit
		merge_head_hash=$(cat "$(git rev-parse --git-dir)/MERGE_HEAD" 2>/dev/null || echo "")
		if [ -n "$merge_head_hash" ]; then
			# Look for refs with that hash (may return many; pick first sensible name)
			merge_target=$(git for-each-ref --format='%(refname:short) %(objectname)' refs/heads | awk -v h="$merge_head_hash" '$2==h {print $1; exit}' || true)
		fi
	fi
fi

run_versionize=false
versionize_args=""

if [ "$is_merge" = true ]; then
	# If merging into main -> versionize; if merging into beta -> pre-release
	case "$merge_target" in
		main|refs/heads/main)
			run_versionize=true
			;;
		beta|refs/heads/beta)
			run_versionize=true
			versionize_args="--pre-release"
			;;
		*)
			# Not merging into main or beta -> skip
			run_versionize=false
			;;
	esac
else
	# Not a merge commit: if current branch is exactly 'beta' then run pre-release
	if [ "$current_branch" = "beta" ]; then
		run_versionize=true
		versionize_args="--pre-release"
	else
		run_versionize=false
	fi
fi

if [ "$run_versionize" = true ]; then
	echo "Running dotnet-versionize${versionize_args:+ with args: $versionize_args} (branch: $current_branch, merge_target: $merge_target)"
	if [ -n "$versionize_args" ]; then
		dotnet husky run --name dotnet-versionize --args "$versionize_args"
	else
		dotnet husky run --name dotnet-versionize
	fi
else
	echo "Skipping versionize (branch: $current_branch, merge_target: $merge_target)"
fi
